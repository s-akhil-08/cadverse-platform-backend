# ==============================================================================
# CADverse Backend - Environment Variables Template
# Copy this file to '.env' and update the values with your actual credentials.
# ==============================================================================

# --- Django Core Settings ---
SECRET_KEY=your-secure-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# --- Database Configuration (PostgreSQL / Supabase) ---
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-region.pooler.supabase.com
DB_NAME=postgres
DB_PORT=6543
DB_USER=postgres.yourprojectref
DB_PASSWORD=yourpassword

# --- Main SMTP Email Settings (OTP & Auth Notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-16-character-app-password
DEFAULT_FROM_EMAIL=CADverse <your-email@gmail.com>
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# --- Signal & Broadcast Email Settings ---
SIGNAL_EMAIL_HOST=smtp.gmail.com
SIGNAL_EMAIL_PORT=587
SIGNAL_EMAIL_USE_TLS=True
SIGNAL_EMAIL_HOST_USER=your-email@gmail.com
SIGNAL_EMAIL_HOST_PASSWORD=your-gmail-16-character-app-password
SIGNAL_DEFAULT_FROM_EMAIL=CADverse Notifications <your-email@gmail.com>

# --- Supabase Cloud Storage & API Keys ---
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_URL_1=https://yourprojectref.supabase.co
SUPABASE_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=cadverse-files
SUPABASE_BUCKET_BEFORE=showcase-before
SUPABASE_BUCKET_AFTER=showcase-after

# --- Frontend & CORS Settings ---
FRONTEND_URL=http://localhost:5173
